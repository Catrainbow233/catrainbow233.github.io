};
const BRAND = {opus48:'claude',sonnet:'claude',haiku:'claude',fable:'claude',gpt:'openai',gptmini:'openai',gemini:'gemini',llama:'meta',qwen:'qwen',deepseek:'deepseek'};
function logoOf(m){ return LOGOS[BRAND[m.id]] || ''; }

/* ===================== 数据 ===================== */
const CATS = [
  {id:'new',  label:'时令上新', new:true},
  {id:'flag', label:'人气\n旗舰榜'},
  {id:'reason',label:'推理特调\n/思考'},
  {id:'multi', label:'多模态\n/鲜视觉'},
  {id:'lite',  label:'轻量快饮\n/低延迟'},
  {id:'open',  label:'经典\n/开源'},
];

/* 价格为官方公开定价，单位：美元 / 百万 token；in=输入，out=输出 */
const MODELS = [
  {id:'opus48', cat:'new', name:'Claude Opus 4.8',
   tags:['上新','算力绿灯','含推理'], ctx:'1M', price:5, out:25,
   desc:'Anthropic 最强 Opus 级模型，高度自主，在长程智能体、复杂编码与知识工作上业界领先。',
   long:'Anthropic 当前最强的 Opus 级模型：高度自主，在长程智能体任务、知识工作与记忆能力上达到业界领先水平，写作更清晰流畅。1M 上下文，标准定价无长上下文溢价。'},
  {id:'gpt', cat:'new', name:'GPT-5.5',
   tags:['上新','算力绿灯','多模态'], ctx:'400K', price:5, out:30,
   desc:'OpenAI 当前旗舰，通用推理、写作与代码全面，工具与生态最成熟。',
   long:'OpenAI 当前旗舰模型，通用推理、写作、代码与多模态能力全面，插件与开发生态最成熟，是覆盖面最广的通用选择。'},
  {id:'sonnet', cat:'flag', name:'Claude Sonnet 4.6',
   tags:['算力绿灯','含推理'], ctx:'1M', price:3, out:15,
   desc:'速度与智能的最佳平衡，日常编码与对话的高性价比之选。',
   long:'Anthropic 在速度与智能之间的最佳平衡之作：响应快、质量高、价格友好，绝大多数日常编码与对话任务的首选。1M 上下文。'},
  {id:'gemini', cat:'multi', name:'Gemini 3 Pro',
   tags:['算力绿灯','多模态','长上下文'], ctx:'1M', price:2, out:12,
   desc:'Google 旗舰多模态模型，超长上下文，原生支持文本 / 图像 / 音视频。',
   long:'Google 旗舰多模态模型，原生支持文本、图像、音频与视频，超长上下文擅长处理整本书与长视频；分层定价，200K 以内 $2/$12。'},
  {id:'haiku', cat:'lite', name:'Claude Haiku 4.5',
   tags:['算力绿灯','低延迟'], ctx:'200K', price:1, out:5,
   desc:'最快、最具性价比的模型，适合简单与高频任务。',
   long:'Anthropic 最快、最具性价比的模型，适合分类、抽取、批量处理与实时交互等高频轻量场景。'},
  {id:'fable', cat:'reason', name:'Claude Fable 5',
   tags:['上新','算力绿灯','含推理'], ctx:'1M', price:10, out:50,
   desc:'Anthropic 迄今最强模型，专为最艰深的推理与长程智能体任务打造。',
   long:'Anthropic 迄今最强的广泛发布模型，面向最艰深的推理与长程智能体工作；思考始终开启，1M 上下文、最高 128K 输出，定价高于 Opus 级。'},
  {id:'gptmini', cat:'lite', name:'GPT-5 mini',
   tags:['低延迟'], ctx:'400K', price:0.25, out:2,
   desc:'GPT-5 轻量版，低成本高速度，适合简单任务与大规模并发。',
   long:'GPT-5 系列的轻量版本，成本低、速度快，适合简单问答、原型验证与大规模并发调用的经济之选。'},
  {id:'qwen', cat:'open', name:'Qwen3 Max',
   tags:['开源','长上下文'], ctx:'256K', price:1.2, out:6,
   desc:'阿里通义千问旗舰，超大参数与长上下文，中文与代码能力突出。',
   long:'阿里巴巴通义千问旗舰，约万亿参数、超长上下文，中文理解与代码能力突出，可经百炼平台调用。'},
  {id:'deepseek', cat:'reason', name:'DeepSeek V3',
   tags:['开源','含推理'], ctx:'128K', price:0.28, out:0.42,
   desc:'极致性价比的推理模型，数学、代码与逻辑见长，开源可部署。',
   long:'DeepSeek 推理性价比标杆，数学、代码与逻辑能力突出，开源可私有化部署，是成本敏感场景的热门选择。'},
  {id:'llama', cat:'open', name:'Llama 4 Maverick',
   tags:['开源','多模态'], ctx:'1M', price:0.15, out:0.6,
   desc:'Meta 开源旗舰，可自由商用与私有化部署，社区生态最丰富。',
   long:'Meta 开源旗舰，原生多模态、可商用、可深度改造；Meta 不自营推理 API，由 Together、Fireworks、Groq 等第三方托管，价格随服务商浮动。'},
];

/* 规格定义 */
const SPECS = [
  {key:'attach', glabel:'原创 · 模室加料·新方式', gname:'是否增加附件', note:'（图片 / 文档）', type:'single',
   opts:[
     {v:'不增加', add:0, def:true},
     {v:'增加附件', add:0},
   ]},
  {key:'size', glabel:'出杯规格', gname:'上下文窗口', note:'（context window）', type:'single',
   opts:[
     {v:'中杯', sub:'256K', add:0, def:true},
     {v:'大杯', sub:'1M', add:0},
   ]},
  {key:'addons', glabel:'灵感小料', gname:'能力加料', note:'（可多选）', type:'multi',
   opts:[
     {v:'联网搜索', add:0},
     {v:'视觉识别', add:0},
     {v:'深度思考', add:0},
   ]},
];

/* ===================== 状态 ===================== */
let curCat='new';
let curModel=null;
let curSel={};      // {temp:idx, size:idx, addons:[idx,...]}
let qty=1;
let cart=[];        // {model, sel, qty, unit}

/* ===================== 渲染：菜单 ===================== */
function renderSide(){
  document.getElementById('side').innerHTML = CATS.map(c=>
    `<div class="cat ${c.id===curCat?'on':''}" onclick="selCat('${c.id}')">
       ${c.new?'<span class="new">上新</span><br>':''}${c.label.replace(/\n/g,'<br>')}
     </div>`).join('');
}
function selCat(id){curCat=id;renderSide();renderList();document.querySelector('#menu .list').scrollTop=0;}

function renderList(){
  const cat = CATS.find(c=>c.id===curCat);
  const items = MODELS.filter(m=>m.cat===curCat);
  let html = `<div class="sect-title">${cat.label.replace(/\n/g,'')}
     ${curCat==='new'?'<span class="hint">看看今日鲜煮</span>':''}</div>`;
  html += items.map(m=>prodCard(m)).join('');
  if(items.length===0) html+=`<div style="padding:40px;text-align:center;color:#bbb">该系列暂未上架</div>`;
  // 推荐
  const recs = MODELS.filter(m=>m.cat!==curCat).slice(0,2);
  html += `<div class="sect-title" style="margin-top:24px">你可能喜欢 <span class="hint">看看你的专属推荐</span></div>`;
  html += recs.map(m=>prodCard(m)).join('');
  document.getElementById('list').innerHTML = html;
}
function prodCard(m){
  return `<div class="prod" onclick="openDetail('${m.id}')">
    <div class="pic">${logoOf(m)}<div class="dot">算力绿灯</div></div>
    <div class="info">
      <div class="nm">${m.name}</div>
      <div class="tagrow">${m.tags.map(t=>`<span class="tag ${t==='上新'?'new':''}">${t}</span>`).join('')}</div>
      <div class="desc">${m.desc}</div>
      <div class="pricerow">
        <div class="price">${money(m.price)}<small> /1M 输入 · 输出${money(m.out)}</small></div>
        <button class="spec-btn" onclick="event.stopPropagation();openDetail('${m.id}')">选规格</button>
      </div>
    </div>
  </div>`;
}

/* ===================== 渲染：详情 ===================== */
function openDetail(id){
  curModel = MODELS.find(m=>m.id===id);
  qty=1;
  curSel={addons:[]};
  // 默认值
  SPECS.forEach(s=>{ if(s.type==='single'){ const di=s.opts.findIndex(o=>o.def); curSel[s.key]= di<0?0:di; }});
  renderDetail();
  show('detail');
  document.querySelector('#detail .scroll').scrollTop=0;
}
function renderDetail(){
  const m=curModel;
  document.getElementById('dEmoji').innerHTML=logoOf(m);
  document.getElementById('dCtx').textContent=m.ctx;
  document.getElementById('dName').textContent=m.name;
  document.getElementById('dTags').innerHTML=m.tags.map(t=>`<span class="tag ${t==='上新'?'new':''}">${t}</span>`).join('');
  document.getElementById('dDesc').textContent=m.long;
  // specs
  document.getElementById('specArea').innerHTML = SPECS.map(s=>specGroup(s)).join('');
  document.getElementById('dQty').textContent=qty;
  updateAddLabel();
}
function specGroup(s){
  const opts = s.opts.map((o,i)=>{
    let on=false;
    if(s.type==='single') on = curSel[s.key]===i;
    else on = curSel.addons.includes(i);
    const addtxt = o.sub?`<span class="add">${o.sub}</span>`:'';
    return `<div class="opt ${on?'on':''}" onclick="pickOpt('${s.key}','${s.type}',${i})">${o.v}${addtxt}</div>`;
  }).join('');
  return `<div class="specgroup">
    <div class="glabel">${s.glabel}</div>
    <div class="gname">${s.gname}<small>${s.note}</small></div>
    <div class="opts">${opts}</div>
  </div>`;
}
function pickOpt(key,type,i){
  if(type==='single') curSel[key]=i;
  else{
    const arr=curSel.addons; const p=arr.indexOf(i);
    if(p>=0) arr.splice(p,1); else arr.push(i);
  }
  document.getElementById('specArea').innerHTML = SPECS.map(s=>specGroup(s)).join('');
  updateAddLabel();
}
function step(d){ qty=Math.max(1,qty+d); document.getElementById('dQty').textContent=qty; updateAddLabel(); }

function unitPrice(){
  let p=curModel.price;
  SPECS.forEach(s=>{
    if(s.type==='single'){ p += s.opts[curSel[s.key]].add; }
    else { curSel.addons.forEach(i=> p+=s.opts[i].add); }
  });
  return p;
}
function money(n){ return '$'+(Math.round(n*100)/100).toFixed(2); }
function updateAddLabel(){
  document.getElementById('addLabel').textContent=`${money(unitPrice()*qty)} /1M · 加入购物袋`;
}

/* ===================== 购物车 ===================== */
function addToCart(){
  cart.push({model:curModel, sel:JSON.parse(JSON.stringify(curSel)), qty:qty, unit:unitPrice()});
  show('menu');
  renderCart();
  flashCart();
}
function cartTotal(){return cart.reduce((s,c)=>s+c.unit*c.qty,0);}
function cartQty(){return cart.reduce((s,c)=>s+c.qty,0);}
function renderCart(){
  const bar=document.getElementById('cartbar');
  const n=cartQty();
  if(n===0){ bar.classList.add('empty');
    document.getElementById('cartCount').style.display='none';
    document.getElementById('cartPrice').innerHTML='<small>未点单</small>'; return;}
  bar.classList.remove('empty');
  const b=document.getElementById('cartCount'); b.style.display='flex'; b.textContent=n;
  document.getElementById('cartPrice').innerHTML=`${money(cartTotal())}<small> /1M 预估</small>`;
}
function flashCart(){
  const bag=document.querySelector('#cartbar .bag');
  bag.animate([{transform:'scale(1)'},{transform:'scale(1.3)'},{transform:'scale(1)'}],{duration:300});
}

/* 规格文字 */
function selText(c){
  let parts=[];
  SPECS.forEach(s=>{
    if(s.type==='single') parts.push(s.opts[c.sel[s.key]].v);
    else c.sel.addons.forEach(i=>parts.push(s.opts[i].v));
  });
  return parts.join('，');
}

/* ===================== 结算 ===================== */
function goCheckout(){
  if(cartQty()===0){flashCart();return;}
  renderCheckout(); show('checkout');
}
function renderCheckout(){
  document.getElementById('coItems').innerHTML = cart.map(c=>`
    <div class="co-item">
      <div class="pic">${logoOf(c.model)}</div>
      <div style="flex:1">
        <div class="nm"><span>${c.model.name}</span><span>${money(c.unit*c.qty)}</span></div>
        <div class="cfg">${selText(c)}</div>
        <div class="qx">x${c.qty}</div>
      </div>
    </div>`).join('');
  const t=cartTotal();
  document.getElementById('coSum').textContent=money(t);
  document.getElementById('coPts').textContent=Math.round(t*0.5);
  document.getElementById('coGrow').textContent=t;
  document.getElementById('payDue').textContent=money(t);
}

/* ===================== 支付 / 小票 ===================== */
function pay(){
  const t=cartTotal();
  let rows = cart.map(c=>`<div class="rl"><span class="k">${c.model.name} x${c.qty}</span><span>${money(c.unit*c.qty)}</span></div>
    <div class="rl"><span class="k" style="font-size:11px">${selText(c)}</span><span></span></div>`).join('');
  const key='sk-mt-zhegeshijiade';
  document.getElementById('receiptBody').innerHTML = rows +
    `<div class="rl"><span class="k">取杯密钥</span><span style="font-family:ui-monospace,Menlo,monospace;font-size:11px;word-break:break-all;text-align:right;max-width:62%">${key}</span></div>
     <div class="rl"><span class="k">出品门店</span><span>纽约节点</span></div>
     <div class="rl tot"><span>合计预估 /1M</span><span>${money(t)}</span></div>`;
  show('success');
}
function resetAll(){ cart=[]; renderCart(); show('menu'); }

/* ===================== 导航 ===================== */
function show(id){
  // success 是覆盖层，单独处理
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
function goMenu(){ renderSide(); renderList(); renderCart(); show('menu'); }

/* init */
renderSide(); renderList();
</script>
</body>
</html>
