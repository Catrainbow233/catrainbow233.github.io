<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>模室 MODELTEA · 点单</title>
<style>
  :root{
    --bg:#f4f4f4;
    --card:#ffffff;
    --ink:#1a1a1a;
    --gray:#9a9a9a;
    --gray2:#c4c4c4;
    --line:#ececec;
    --green:#5a9c3f;     /* 上新 / 绿灯 */
    --black:#111111;
    --radius:14px;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    background:#dcdcdc;
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;
    color:var(--ink);
    display:flex;justify-content:center;align-items:flex-start;
    min-height:100vh;padding-top:60px;
  }
  /* ===== page frame (3:4) ===== */
  .phone{
    width:480px;height:640px;        /* 3:4 */
    background:var(--bg);
    position:relative;overflow:hidden;
    border-radius:8px;
    box-shadow:0 12px 48px rgba(0,0,0,.16);
    border:1px solid #e6e6e6;
  }
  @media (max-width:520px){
    body{background:var(--bg);}
    .phone{width:100vw;height:133.33vw;max-height:100vh;border-radius:0;border:none;box-shadow:none;}
  }

  /* screens */
  .screen{position:absolute;inset:0;display:none;flex-direction:column;background:var(--bg);}
  .screen.active{display:flex;}
  .scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;}
  .scroll::-webkit-scrollbar{display:none;}

  /* generic nav header */
  .nav{height:46px;display:flex;align-items:center;justify-content:center;position:relative;flex-shrink:0;}
  .nav .title{font-size:17px;font-weight:600;}
  .nav .back{position:absolute;left:18px;font-size:22px;line-height:1;cursor:pointer;}
  .capsule{position:absolute;right:14px;top:50%;transform:translateY(-50%);
    display:flex;align-items:center;gap:0;border:1px solid #e3e3e3;border-radius:18px;
    height:32px;background:rgba(255,255,255,.6);backdrop-filter:blur(4px);}
  .capsule span{width:44px;text-align:center;font-size:16px;}
  .capsule .div{width:1px;height:16px;background:#e0e0e0;}

  /* ============ MENU ============ */
  #menu .menu-head{background:#3a3a3a;color:#fff;padding:8px 18px 16px;flex-shrink:0;}
  #menu .menu-head .tabs{display:flex;align-items:center;gap:14px;margin-bottom:10px;}
  #menu .menu-head .tabs .t1{font-size:20px;font-weight:700;}
  #menu .menu-head .tabs .t2{font-size:16px;color:#bdbdbd;}
  #menu .menu-head .store{font-size:21px;font-weight:600;display:flex;align-items:center;gap:6px;}
  #menu .menu-head .sub{font-size:12px;color:#aaa;margin-top:6px;}
  #menu .menu-head .en{font-size:13px;color:#cfcfcf;margin-top:8px;display:flex;align-items:center;gap:4px;}
  #menu .menu-head .icons{position:absolute;right:16px;top:54px;display:flex;gap:10px;}
  #menu .menu-head .icons div{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:16px;}

  #menu .body{flex:1;display:flex;overflow:hidden;}
  #menu .side{width:96px;flex-shrink:0;background:#f4f4f4;overflow-y:auto;padding-top:8px;}
  #menu .side::-webkit-scrollbar{display:none;}
  #menu .side .cat{padding:16px 8px 16px 16px;font-size:13px;color:#888;line-height:1.35;cursor:pointer;position:relative;}
  #menu .side .cat.on{color:#111;font-weight:700;background:#fff;}
  #menu .side .cat.on::before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:18px;background:#111;}
  #menu .side .cat .new{display:inline-block;background:var(--green);color:#fff;font-size:10px;padding:1px 5px;border-radius:3px;margin-bottom:4px;font-weight:600;}

  #menu .list{flex:1;background:#fff;overflow-y:auto;padding:4px 16px 90px;}
  #menu .list::-webkit-scrollbar{display:none;}
  #menu .sect-title{font-size:16px;font-weight:700;margin:16px 0 4px;display:flex;align-items:center;gap:8px;}
  #menu .sect-title .hint{font-size:11px;color:#999;font-weight:400;background:#f1f1f1;padding:2px 8px;border-radius:10px;}
  .prod{display:flex;gap:12px;padding:18px 0;border-bottom:1px solid var(--line);}
  .prod .pic{width:96px;height:96px;border-radius:10px;background:#f5f5f5;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:42px;position:relative;}
  .prod .pic .dot{position:absolute;left:6px;bottom:6px;font-size:9px;color:var(--green);display:flex;align-items:center;gap:3px;font-weight:600;}
  .prod .pic .dot::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green);}
  .prod .info{flex:1;min-width:0;}
  .prod .nm{font-size:17px;font-weight:700;}
  .prod .tagrow{display:flex;gap:6px;margin:7px 0;flex-wrap:wrap;}
  .tag{font-size:11px;padding:2px 7px;border:1px solid #d0d0d0;border-radius:4px;color:#777;}
  .tag.new{background:var(--green);border-color:var(--green);color:#fff;font-weight:600;}
  .prod .desc{font-size:12px;color:#9a9a9a;line-height:1.5;margin-bottom:10px;}
  .prod .pricerow{display:flex;align-items:center;justify-content:space-between;}
  .prod .price{font-size:19px;font-weight:700;}
  .prod .price small{font-size:11px;color:#999;font-weight:400;}
  .prod .spec-btn{background:#111;color:#fff;border:none;font-size:13px;font-weight:600;padding:8px 16px;border-radius:6px;cursor:pointer;}

  /* UI 线性图标 (单色，跟随 currentColor) */
  .uic{display:inline-block;vertical-align:-3px;width:18px;height:18px;}
  .uic.sm{width:14px;height:14px;vertical-align:-2px;}
  .capsule .uic{width:17px;height:17px;vertical-align:middle;}
  .cartbar .bag .uic{width:28px;height:28px;}
  .fav .uic{width:16px;height:16px;}
  .receipt .check .uic{width:26px;height:26px;}
  .co-card.promo .price .uic{width:20px;height:20px;vertical-align:middle;}

  /* brand logos (单色，跟随 currentColor) */
  .blogo{display:block;color:#1a1a1a;}
  .prod .pic .blogo{width:50px;height:50px;}
  #detail .dpic .blogo{width:128px;height:128px;}
  #detail .thumbs .th .blogo{width:26px;height:26px;}
  .co-item .pic .blogo{width:38px;height:38px;}

  /* cart bar */
  .cartbar{position:absolute;left:0;right:0;bottom:0;height:60px;background:#fbfbfb;
    display:flex;align-items:center;padding-left:18px;box-shadow:0 -4px 16px rgba(0,0,0,.05);z-index:20;}
  .cartbar.hide{display:none;}
  .cartbar .bag{position:relative;font-size:30px;}
  .cartbar .bag .badge{position:absolute;right:-6px;top:-4px;background:#111;color:#fff;font-size:11px;
    min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;}
  .cartbar .cprice{font-size:24px;font-weight:700;margin-left:14px;}
  .cartbar .cprice small{font-size:13px;font-weight:400;color:#999;}
  .cartbar .checkout{margin-left:auto;width:140px;align-self:stretch;background:#111;color:#fff;border:none;
    font-size:17px;font-weight:600;cursor:pointer;}
  .cartbar.empty .checkout{background:#bdbdbd;}

  /* bottom nav */
  .tabbar{height:50px;display:flex;background:#fff;border-top:1px solid #eee;flex-shrink:0;z-index:10;}
  .tabbar .tab{flex:1;display:flex;align-items:center;justify-content:center;font-size:15px;color:#999;cursor:pointer;}
  .tabbar .tab.on{color:#111;font-weight:700;}

  /* ============ DETAIL (sheet) ============ */
  #detail{z-index:40;}
  #detail .scroll{padding-bottom:96px;}
  #detail .dpic{height:300px;background:#f3f3f3;display:flex;align-items:center;justify-content:center;font-size:120px;position:relative;}
  #detail .dpic .green{position:absolute;left:18px;bottom:16px;font-size:12px;color:var(--green);font-weight:600;}
  #detail .dpic .green b{font-size:22px;}
  #detail .dpic .ctx{position:absolute;right:16px;bottom:16px;font-size:10px;color:#bbb;text-align:right;line-height:1.6;}
  #detail .dtopbar{position:absolute;top:0;left:0;right:0;height:46px;display:flex;align-items:center;padding:0 16px;z-index:5;}
  #detail .dtopbar .back{font-size:24px;cursor:pointer;}
  #detail .dbody{background:#fff;border-radius:0;padding:20px 18px 0;}
  #detail .dname{font-size:26px;font-weight:800;}
  #detail .dtags{display:flex;gap:6px;margin:12px 0 16px;flex-wrap:wrap;}
  #detail .thumbs{display:flex;gap:10px;padding-bottom:18px;border-bottom:1px solid var(--line);overflow-x:auto;}
  #detail .thumbs::-webkit-scrollbar{display:none;}
  #detail .thumbs .th{width:54px;height:54px;border-radius:50%;background:#f3f3f3;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24px;border:2px solid transparent;}
  #detail .thumbs .th.on{border-color:#111;}
  #detail .reveal{display:flex;align-items:center;gap:8px;color:#8a6d4b;font-size:15px;font-weight:600;padding:18px 0 6px;}
  #detail .ddesc{font-size:14px;color:#444;line-height:1.7;}
  #detail .ddesc .more{color:#aaa;font-size:13px;margin-top:6px;}

  .specgroup{padding:22px 0 6px;border-bottom:1px solid var(--line);}
  .specgroup .glabel{font-size:13px;color:#a98;font-weight:600;margin-bottom:2px;}
  .specgroup .gname{font-size:15px;font-weight:700;margin-bottom:14px;}
  .specgroup .gname small{font-size:12px;color:#aaa;font-weight:400;margin-left:6px;}
  .opts{display:flex;gap:12px;flex-wrap:wrap;}
  .opt{padding:11px 16px;background:#f3f3f3;border-radius:6px;font-size:14px;color:#333;cursor:pointer;border:1px solid transparent;position:relative;}
  .opt.on{background:#111;color:#fff;}
  .opt .add{font-size:11px;color:#999;margin-left:4px;}
  .opt.on .add{color:#ccc;}
  .opt .free{font-size:11px;color:var(--green);margin-left:4px;}
  .opt.on .free{color:#9fd98a;}

  /* detail bottom bar */
  #detail .dbottom{position:absolute;left:0;right:0;bottom:0;background:#fff;padding:10px 16px 14px;box-shadow:0 -4px 16px rgba(0,0,0,.06);}
  #detail .qrow{display:flex;align-items:center;margin-bottom:10px;}
  #detail .fav{display:flex;align-items:center;gap:6px;font-size:14px;color:#666;}
  #detail .stepper{margin-left:auto;display:flex;align-items:center;gap:16px;}
  #detail .stepper .b{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;cursor:pointer;border:1.5px solid #ddd;color:#666;}
  #detail .stepper .b.plus{background:#111;color:#fff;border-color:#111;}
  #detail .stepper .q{font-size:17px;font-weight:600;min-width:18px;text-align:center;}
  #detail .addcart{width:100%;height:54px;background:#111;color:#fff;border:none;border-radius:12px;
    font-size:17px;font-weight:700;cursor:pointer;}

  /* ============ CHECKOUT ============ */
  #checkout .scroll{padding:0 14px 100px;}
  .co-card{background:#fff;border-radius:var(--radius);padding:18px;margin-top:12px;}
  .co-pickup{display:flex;align-items:flex-start;gap:12px;}
  .co-pickup .badge{background:#111;color:#fff;font-size:13px;font-weight:600;padding:3px 8px;border-radius:5px;white-space:nowrap;}
  .co-pickup .store{font-size:20px;font-weight:700;}
  .co-pickup .eta{font-size:13px;color:#888;margin-top:8px;}
  .co-pickup .km{margin-left:auto;font-size:12px;color:#aaa;background:#f4f4f4;padding:4px 10px;border-radius:12px;}
  .co-diy{display:flex;align-items:center;font-size:16px;font-weight:600;}
  .co-diy .sub{color:#999;font-weight:400;font-size:14px;margin-left:4px;}
  .co-diy .go{margin-left:auto;color:#bbb;font-size:14px;font-weight:400;}
  .co-sect{font-size:20px;font-weight:800;margin-bottom:6px;}
  .co-item{display:flex;gap:12px;padding:6px 0;}
  .co-item .pic{width:70px;height:80px;border-radius:8px;background:#f4f4f4;display:flex;align-items:center;justify-content:center;font-size:36px;flex-shrink:0;}
  .co-item .nm{font-size:17px;font-weight:700;display:flex;justify-content:space-between;}
  .co-item .cfg{font-size:13px;color:#9a9a9a;line-height:1.6;margin-top:6px;}
  .co-item .qx{font-size:13px;color:#999;text-align:right;margin-top:4px;}
  .co-row{display:flex;align-items:center;padding:16px 0;border-top:1px solid var(--line);font-size:16px;}
  .co-row .r{margin-left:auto;color:#bbb;font-size:14px;}
  .co-row.first{border-top:none;}
  .co-card.promo{background:#f1f0e6;}
  .co-card.promo .t{font-size:16px;font-weight:700;}
  .co-card.promo .s{font-size:12px;color:#999;margin-top:4px;}
  .co-card.promo .price{margin-left:auto;font-size:17px;font-weight:700;}
  .co-card.promo .price small{font-size:12px;color:#999;font-weight:400;}
  .co-total{text-align:right;padding-top:14px;}
  .co-total .sum{font-size:15px;}
  .co-total .sum b{font-size:26px;}
  .co-total .pts{font-size:13px;color:#999;margin-top:8px;}

  /* checkout pay bar */
  #checkout .paybar{position:absolute;left:0;right:0;bottom:0;height:84px;background:#fff;display:flex;align-items:center;padding:0 0 0 24px;box-shadow:0 -4px 16px rgba(0,0,0,.06);}
  #checkout .paybar .due{font-size:16px;}
  #checkout .paybar .due b{font-size:30px;font-weight:800;}
  #checkout .paybar .pay{margin-left:auto;width:150px;height:84px;background:#111;color:#fff;border:none;font-size:20px;font-weight:700;cursor:pointer;}

  /* ============ SUCCESS ============ */
  #success{z-index:50;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;}
  #success.active{display:flex;}
  .receipt{width:300px;background:#fff;border-radius:8px;padding:0;position:relative;
    box-shadow:0 20px 60px rgba(0,0,0,.4);
    -webkit-mask:radial-gradient(circle at 0 70%,transparent 8px,#000 9px) left/51% 100% no-repeat,
                 radial-gradient(circle at 100% 70%,transparent 8px,#000 9px) right/51% 100% no-repeat;}
  .receipt .rhead{text-align:center;padding:26px 20px 14px;border-bottom:2px dashed #e0e0e0;}
  .receipt .check{display:flex;align-items:center;justify-content:center;margin:0 auto 12px;}
  .receipt .check .clawd{width:96px;height:auto;display:block;image-rendering:pixelated;}
  .receipt .rhead h3{font-size:19px;font-weight:800;}
  .receipt .rhead p{font-size:12px;color:#999;margin-top:4px;}
  .receipt .rbody{padding:16px 22px;}
  .receipt .rl{display:flex;justify-content:space-between;font-size:13px;padding:5px 0;color:#444;}
  .receipt .rl .k{color:#999;}
  .receipt .rl.tot{border-top:2px dashed #e0e0e0;margin-top:8px;padding-top:12px;font-size:15px;font-weight:800;color:#111;}
  .receipt .rfoot{text-align:center;font-size:11px;color:#bbb;padding:0 20px 22px;line-height:1.6;}
  .receipt .close{display:block;width:calc(100% - 44px);margin:0 22px 22px;height:46px;background:#111;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;}
</style>
</head>
<body>
<div class="phone">

  <!-- ===================== MENU ===================== -->
  <div class="screen active" id="menu">
    <div class="menu-head">
      <div class="tabs"><span class="t1">到店取</span><span style="color:#777">|</span><span class="t2">模搭外送</span></div>
      <div class="store">模室 · 算力中央厨房店 ›</div>
      <div class="sub">距离您 28ms · 纽约节点直供</div>
      <div class="en">smarter models, by token ›</div>
      <div class="icons"><div><svg class="uic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></div><div>···</div></div>
    </div>
    <div class="body">
      <div class="side" id="side"></div>
      <div class="list" id="list"></div>
    </div>
    <div class="cartbar empty" id="cartbar" onclick="goCheckout()">
      <div class="bag"><svg class="uic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 8h12l1 12H5z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span class="badge" id="cartCount" style="display:none">0</span></div>
      <div class="cprice" id="cartPrice"><small>未点单</small></div>
      <button class="checkout">结算</button>
    </div>
  </div>

  <!-- ===================== DETAIL ===================== -->
  <div class="screen" id="detail">
    <div class="scroll">
      <div class="dpic">
        <div class="dtopbar"><div class="back" onclick="show('menu')">‹</div></div>
        <span id="dEmoji"></span>
        <div class="green"><b id="dCtx">200K</b> 上下文/次</div>
        <div class="ctx">参数估算 · 推荐状态<br>不另加费用项下标准出品</div>
      </div>
      <div class="dbody">
        <div class="dname" id="dName">模型名</div>
        <div class="dtags" id="dTags"></div>
        <div class="reveal"><svg class="uic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4" stroke-linecap="round"/><circle cx="12" cy="8.2" r="1.1" fill="currentColor" stroke="none"/></svg> 参数 / 训练 / 能力揭秘 &nbsp;⟶</div>
        <div class="ddesc"><span id="dDesc"></span><div class="more">展开更多 <svg class="uic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></div></div>
        <div id="specArea"></div>
        <div style="height:20px"></div>
      </div>
    </div>
    <div class="dbottom">
      <div class="qrow">
        <div class="fav"><svg class="uic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.4 12 20 12 20Z"/></svg> 保存口味</div>
        <div class="stepper">
          <div class="b" onclick="step(-1)">−</div>
          <div class="q" id="dQty">1</div>
          <div class="b plus" onclick="step(1)">＋</div>
        </div>
      </div>
      <button class="addcart" onclick="addToCart()"><span id="addLabel">$0.00 /1M · 加入购物袋</span></button>
    </div>
  </div>

  <!-- ===================== CHECKOUT ===================== -->
  <div class="screen" id="checkout">
    <div class="nav">
      <div class="back" onclick="show('menu')">‹</div>
      <div class="title">订单结算</div>
    </div>
    <div class="scroll">
      <div class="co-card">
        <div class="co-pickup">
          <span class="badge">到店取</span>
          <div>
            <div class="store">算力中央厨房店 ›</div>
            <div class="eta">立刻为您推理，预计 0.8 秒后出杯</div>
          </div>
          <div class="km">0.0ms</div>
        </div>
      </div>
      <div class="co-card co-diy">
        <span><svg class="uic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M16 4l4 4L8 20H4v-4z"/><path d="M14 6l4 4"/></svg> DIY 人设</span><span class="sub">| 邀你灵感一现</span>
        <span class="go">去定制 ›</span>
      </div>
      <div class="co-card">
        <div class="co-sect">商品明细</div>
        <div id="coItems"></div>
        <div class="co-row"><span>打包方式</span><span class="r"><svg class="uic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a8 8 0 0 1 14-3l2 2"/><path d="M20 5v4h-4"/><path d="M20 16a8 8 0 0 1-14 3l-2-2"/><path d="M4 19v-4h4"/></svg> 流式输出 ›</span></div>
      </div>
      <div class="co-card promo" style="display:flex;align-items:center">
        <div>
          <div class="t">开「金算卡」本单可减 ¥2 ›</div>
          <div class="s">享 90 天最高可省 ¥98</div>
        </div>
        <div class="price">¥8.8<small>/90天</small> <svg class="uic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/></svg></div>
      </div>
      <div class="co-card">
        <div class="co-row first"><span>模室券</span><span class="r">暂无可用 ›</span></div>
        <div class="co-row"><span>开发者特权</span><span class="r">暂无可用 ›</span></div>
        <div class="co-total">
          <div class="sum">小计 <b id="coSum">$0.00</b></div>
          <div class="pts">可得 <svg class="uic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="12" rx="9" ry="6"/><path d="M3 12v3c0 3.3 4 6 9 6s9-2.7 9-6v-3"/></svg> 积分 <span id="coPts">0</span> &nbsp;|&nbsp; <svg class="uic sm" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l2 7 7 2-7 2-2 7-2-7-7-2 7-2z"/></svg> 成长值 <span id="coGrow">0</span></div>
        </div>
      </div>
      <div class="co-card">
        <div class="co-row first" style="color:#999">支付方式</div>
      </div>
    </div>
    <div class="paybar">
      <div class="due">待支付 <b id="payDue">$0.00</b></div>
      <button class="pay" onclick="pay()">支付</button>
    </div>
  </div>

  <!-- ===================== SUCCESS ===================== -->
  <div class="screen" id="success">
    <div class="receipt">
      <div class="rhead">
        <div class="check"><img class="clawd" alt="Clawd" src="data:image/png;base64,"></div>
        <h3>出杯成功</h3>
        <p>MODELTEA · 算力中央厨房店</p>
      </div>
      <div class="rbody" id="receiptBody"></div>
      <div class="rfoot">本小票为体验演示 · 不产生真实调用与扣费<br>感谢品尝今日模型</div>
      <button class="close" onclick="resetAll()">再来一单</button>
    </div>
  </div>

</div>

<script>
/* ===================== 品牌 LOGO (Simple Icons / svgl，单色) ===================== */
